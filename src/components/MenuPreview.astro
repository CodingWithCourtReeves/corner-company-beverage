---
import { Image } from "astro:assets";
import MenuList from "./MenuList.astro";
import { featuredItems } from "../data/menu.ts";
import pastryTray from "../assets/photos/pastry-tray.jpg";
---
<section class="bg-cream" aria-labelledby="menu-preview-heading">
  <div class="mx-auto max-w-6xl px-6 py-16 grid gap-12 md:grid-cols-12 items-stretch">
    <div class="md:col-span-7">
      <p class="uppercase tracking-[0.3em] text-xs text-cocoa mb-4">From the menu</p>
      <h2 id="menu-preview-heading" class="font-display text-4xl text-forest mb-6">A few favorites.</h2>
      <MenuList items={featuredItems.slice(0, 6)} />
      <a href="/menu" class="mt-8 inline-flex items-center gap-2 text-forest font-medium uppercase tracking-[0.18em] text-xs underline underline-offset-8 decoration-cocoa/40 hover:decoration-forest">
        See the full menu →
      </a>
    </div>
    <figure class="md:col-span-5 relative">
      <Image
        src={pastryTray}
        alt="House-made rustic loaves on a dark stone counter, dusted with grain."
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="lazy"
        class="w-full h-full object-cover rounded-sm aspect-[4/5] md:aspect-auto md:absolute md:inset-0"
      />
      <figcaption class="absolute bottom-4 left-4 right-4 md:left-6 md:right-6 md:bottom-6 text-cream/95 text-sm font-display italic drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)] pointer-events-none">
        Baked this morning. Gone by lunch.
      </figcaption>
    </figure>
  </div>
</section>
