---
import Monogram from "./Monogram.astro";
interface Props {
  transparentAtTop?: boolean;
}
const { transparentAtTop = false } = Astro.props;
---
<header
  data-transparent={transparentAtTop ? "true" : "false"}
  data-scrolled="false"
  class:list={[
    "fixed top-0 left-0 right-0 z-40 transition-colors duration-300 text-forest",
    transparentAtTop ? "bg-transparent" : "bg-cream/95 backdrop-blur",
  ]}
>
  <nav aria-label="Primary" class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Monogram class="w-10 h-10" title="" />
      <span class="font-display text-lg tracking-tight">Corner Company</span>
      <span class="sr-only">home</span>
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium uppercase tracking-[0.18em]">
      <li><a href="/menu" class="hover:opacity-80">Menu</a></li>
      <li><a href="/#visit" class="hover:opacity-80">Visit</a></li>
    </ul>
  </nav>
</header>

<style>
  header[data-transparent="true"][data-scrolled="false"] {
    color: var(--color-cream);
    /* Opaque-enough background so the cream text passes WCAG AA when
       composited over the body cream beneath. Also creates a subtle
       dark scrim band visible over the hero. */
    background-color: rgba(31, 42, 36, 0.78);
    text-shadow: 0 1px 2px rgba(0,0,0,0.35);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("header[data-transparent='true']");
  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      header.dataset.scrolled = scrolled ? "true" : "false";
      if (scrolled) {
        header.classList.remove("bg-transparent");
        header.classList.add("bg-cream/95", "backdrop-blur", "shadow-[0_1px_0_0_rgba(31,42,36,0.08)]");
      } else {
        header.classList.add("bg-transparent");
        header.classList.remove("bg-cream/95", "backdrop-blur", "shadow-[0_1px_0_0_rgba(31,42,36,0.08)]");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
