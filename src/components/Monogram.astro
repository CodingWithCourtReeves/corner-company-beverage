---
interface Props {
  class?: string;
  title?: string;
}
const { class: className = "", title = "Corner Company Beverage Emporium monogram" } = Astro.props;
---
<svg
  viewBox="0 0 120 120"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
  class={className}
  fill="currentColor"
  stroke="currentColor"
>
  <title>{title}</title>
  <defs>
    <path id="ribbon-arc" d="M 18 78 A 50 50 0 0 0 102 78" fill="none" />
  </defs>

  <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx="60" cy="60" r="50" fill="none" stroke="currentColor" stroke-width="0.75" />
  <circle cx="60" cy="8" r="1.5" stroke="none" />
  <circle cx="60" cy="112" r="1.5" stroke="none" />

  <text x="60" y="48" text-anchor="middle" font-family="Fraunces Variable, Fraunces, serif" font-size="34" font-weight="500" stroke="none">C</text>
  <text x="60" y="62" text-anchor="middle" font-family="Fraunces Variable, Fraunces, serif" font-style="italic" font-size="14" stroke="none">&amp;</text>
  <text x="60" y="80" text-anchor="middle" font-family="Fraunces Variable, Fraunces, serif" font-size="34" font-weight="500" stroke="none">C</text>

  <text font-family="Inter Variable, Inter, sans-serif" font-size="7" letter-spacing="2.5" stroke="none">
    <textPath href="#ribbon-arc" startOffset="50%" text-anchor="middle">BEVERAGE EMPORIUM</textPath>
  </text>
</svg>
